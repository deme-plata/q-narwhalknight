#!/usr/bin/env cargo run --bin test_dht_gossip_coordinator
//! Test DHT-to-Gossip Coordinator Integration
//!
//! This test validates the complete pipeline:
//! BEP-44 DHT Discovery → DHT Events → Libp2p Bridge → Gossip Network → Consensus Layer
//!
//! Performance Targets:
//! - DHT discovery: <30s bootstrap time
//! - Gossip delivery: <1s message propagation
//! - End-to-end latency: <2s from DHT discovery to consensus
//!
//! Author: Server Beta - Q-NarwhalKnight Development Team

use anyhow::Result;
use std::time::{Duration, Instant};
use tokio::time::timeout;
use tracing::{info, warn, error, debug};

// Import our network components
use q_network::{
    libp2p_bridge::{DhtEvent, BridgeEvent},
    dht_gossip_coordinator::{DhtGossipCoordinator, CoordinatorConfig},
};
use q_bep44_discovery::{Bep44DiscoveryConfig, DiscoveryEngine};

/// Main test runner for DHT-to-Gossip coordinator
#[tokio::main]
async fn main() -> Result<()> {
    // Initialize logging
    tracing_subscriber::fmt()
        .with_env_filter("debug,libp2p=info,rust_dht=info")
        .init();

    info!("🧪 Starting DHT-to-Gossip Coordinator Integration Tests");
    info!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

    // Run comprehensive test suite
    let start_time = Instant::now();

    // Test 1: Coordinator Creation and Initialization
    test_coordinator_creation().await?;

    // Test 2: Bridge Integration
    test_bridge_integration().await?;

    // Test 3: DHT Discovery Pipeline
    test_dht_discovery_pipeline().await?;

    // Test 4: End-to-End Performance
    test_end_to_end_performance().await?;

    // Test 5: Multi-Node Gossip Validation
    test_multi_node_gossip().await?;

    let total_duration = start_time.elapsed();

    info!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    info!("✅ ALL TESTS PASSED - DHT-to-Gossip Integration Complete");
    info!("⏱️  Total test duration: {:.2}s", total_duration.as_secs_f64());
    info!("🎯 Pipeline: BEP-44 DHT → Gossip → Consensus VALIDATED");
    info!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

    Ok(())
}

/// Test 1: Basic coordinator creation and configuration
async fn test_coordinator_creation() -> Result<()> {
    info!("🔧 Test 1: Coordinator Creation and Configuration");

    let node_id = [1u8; 32];
    let dht_config = Bep44DiscoveryConfig {
        bootstrap_timeout_secs: 30,
        enable_ipv6: false,
        custom_bootstrap_nodes: vec![
            "dht.transmissionbt.com:6881".to_string(),
            "router.bittorrent.com:6881".to_string(),
        ],
        ..Default::default()
    };

    let coordinator_config = CoordinatorConfig {
        dht_discovery_interval_secs: 15,  // Faster for testing
        bridge_event_interval_ms: 50,     // Faster event processing
        auto_announce_discovered_peers: true,
        enable_metrics: true,
        libp2p_key_seed: Some([42u8; 32]), // Deterministic for testing
    };

    // Create coordinator
    let coordinator = DhtGossipCoordinator::new(
        node_id,
        dht_config,
        coordinator_config
    ).await?;

    info!("   ✅ Coordinator created successfully");
    info!("   • Node ID: {}", hex::encode(&node_id[..8]));
    info!("   • DHT config: optimized for testing");
    info!("   • Bridge config: fast event processing");

    // Validate coordinator status
    let status = coordinator.get_coordinator_status().await?;
    assert!(!status.is_running);
    assert_eq!(status.discovered_peer_count, 0);

    info!("   ✅ Coordinator status validation passed");

    Ok(())
}

/// Test 2: Bridge initialization and integration
async fn test_bridge_integration() -> Result<()> {
    info!("🌉 Test 2: Bridge Integration and Initialization");

    let node_id = [2u8; 32];
    let dht_config = Bep44DiscoveryConfig::default();
    let coordinator_config = CoordinatorConfig {
        libp2p_key_seed: Some([84u8; 32]), // Different seed
        ..Default::default()
    };

    let mut coordinator = DhtGossipCoordinator::new(
        node_id,
        dht_config,
        coordinator_config
    ).await?;

    // Initialize bridge
    coordinator.initialize_bridge().await?;
    info!("   ✅ Libp2p bridge initialized successfully");

    // Validate bridge is ready
    let status = coordinator.get_coordinator_status().await?;
    assert!(status.bridge_peer_id.contains("bridge_running"));

    info!("   ✅ Bridge integration validation passed");
    info!("   • Bridge peer ID: {}", status.bridge_peer_id);

    Ok(())
}

/// Test 3: DHT discovery pipeline functionality
async fn test_dht_discovery_pipeline() -> Result<()> {
    info!("🔍 Test 3: DHT Discovery Pipeline");

    let node_id = [3u8; 32];
    let dht_config = Bep44DiscoveryConfig {
        bootstrap_timeout_secs: 45, // More time for real discovery
        enable_discovery_acceleration: true,
        target_peer_count: 5,
        ..Default::default()
    };
    let coordinator_config = CoordinatorConfig::default();

    let mut coordinator = DhtGossipCoordinator::new(
        node_id,
        dht_config,
        coordinator_config
    ).await?;

    // Initialize and start coordinator
    coordinator.initialize_bridge().await?;

    info!("   🚀 Starting DHT discovery coordinator...");
    let start_time = Instant::now();
    coordinator.start().await?;

    let startup_time = start_time.elapsed();
    info!("   ✅ Coordinator started in {:.2}s", startup_time.as_secs_f64());

    // Wait for DHT to bootstrap and discover peers
    info!("   ⏳ Waiting for DHT bootstrap and peer discovery...");
    tokio::time::sleep(Duration::from_secs(30)).await;

    // Get coordinator status after discovery period
    let status = coordinator.get_coordinator_status().await?;
    info!("   📊 Discovery results:");
    info!("      • Running: {}", status.is_running);
    info!("      • Discovered peers: {}", status.discovered_peer_count);
    info!("      • Events forwarded: {}", status.total_events_forwarded);

    // Force immediate discovery to test manual trigger
    info!("   🔄 Testing force discovery...");
    let force_start = Instant::now();
    let announced_peers = coordinator.force_discovery_and_announce().await?;
    let force_time = force_start.elapsed();

    info!("   ✅ Force discovery completed in {:.2}s", force_time.as_secs_f64());
    info!("      • Announced peers: {}", announced_peers.len());

    // Stop coordinator cleanly
    coordinator.stop().await?;
    info!("   ✅ Coordinator stopped successfully");

    // Validate final status
    let final_status = coordinator.get_coordinator_status().await?;
    assert!(!final_status.is_running);

    Ok(())
}

/// Test 4: End-to-end performance validation
async fn test_end_to_end_performance() -> Result<()> {
    info!("⚡ Test 4: End-to-End Performance Validation");

    let node_id = [4u8; 32];
    let dht_config = Bep44DiscoveryConfig {
        bootstrap_timeout_secs: 30,
        enable_performance_mode: true,
        ..Default::default()
    };
    let coordinator_config = CoordinatorConfig {
        dht_discovery_interval_secs: 10, // Fast discovery
        bridge_event_interval_ms: 25,    // Low latency event processing
        auto_announce_discovered_peers: true,
        enable_metrics: true,
        ..Default::default()
    };

    let mut coordinator = DhtGossipCoordinator::new(
        node_id,
        dht_config,
        coordinator_config
    ).await?;

    // Performance test: Measure bridge initialization time
    let bridge_start = Instant::now();
    coordinator.initialize_bridge().await?;
    let bridge_time = bridge_start.elapsed();

    info!("   📈 Bridge initialization: {:.2}s", bridge_time.as_secs_f64());
    assert!(bridge_time < Duration::from_secs(5), "Bridge initialization too slow");

    // Performance test: Measure coordinator startup time
    let startup_start = Instant::now();
    coordinator.start().await?;
    let startup_time = startup_start.elapsed();

    info!("   📈 Coordinator startup: {:.2}s", startup_time.as_secs_f64());
    assert!(startup_time < Duration::from_secs(10), "Coordinator startup too slow");

    // Performance test: Force discovery latency
    let discovery_start = Instant::now();
    let _announced = coordinator.force_discovery_and_announce().await?;
    let discovery_time = discovery_start.elapsed();

    info!("   📈 Force discovery latency: {:.2}s", discovery_time.as_secs_f64());
    assert!(discovery_time < Duration::from_secs(30), "Discovery too slow");

    // Performance test: Status query time
    let status_start = Instant::now();
    let _status = coordinator.get_coordinator_status().await?;
    let status_time = status_start.elapsed();

    info!("   📈 Status query latency: {:.2}ms", status_time.as_millis());
    assert!(status_time < Duration::from_millis(100), "Status query too slow");

    // Clean shutdown
    coordinator.stop().await?;

    info!("   ✅ All performance targets met");
    info!("   🎯 DHT-to-Gossip pipeline performance validated");

    Ok(())
}

/// Test 5: Multi-node gossip validation (simulated)
async fn test_multi_node_gossip() -> Result<()> {
    info!("🕸️  Test 5: Multi-Node Gossip Network Simulation");

    // Create 3 coordinators for multi-node testing
    let node_configs = vec![
        ([5u8; 32], [100u8; 32]), // (node_id, libp2p_seed)
        ([6u8; 32], [101u8; 32]),
        ([7u8; 32], [102u8; 32]),
    ];

    let mut coordinators = Vec::new();

    // Initialize all coordinators
    for (i, (node_id, seed)) in node_configs.iter().enumerate() {
        let dht_config = Bep44DiscoveryConfig {
            bootstrap_timeout_secs: 30,
            custom_node_id: Some(*node_id),
            ..Default::default()
        };

        let coordinator_config = CoordinatorConfig {
            dht_discovery_interval_secs: 20,
            bridge_event_interval_ms: 100,
            auto_announce_discovered_peers: true,
            enable_metrics: true,
            libp2p_key_seed: Some(*seed),
        };

        let mut coordinator = DhtGossipCoordinator::new(
            *node_id,
            dht_config,
            coordinator_config
        ).await?;

        coordinator.initialize_bridge().await?;
        info!("   ✅ Node {} initialized", i + 1);

        coordinators.push(coordinator);
    }

    // Start all coordinators
    let start_time = Instant::now();
    for (i, coordinator) in coordinators.iter_mut().enumerate() {
        coordinator.start().await?;
        info!("   🚀 Node {} started", i + 1);
    }

    let startup_duration = start_time.elapsed();
    info!("   ✅ All nodes started in {:.2}s", startup_duration.as_secs_f64());

    // Let the network establish connections and exchange gossip
    info!("   ⏳ Allowing network convergence (30s)...");
    tokio::time::sleep(Duration::from_secs(30)).await;

    // Collect statistics from all nodes
    let mut total_peers = 0;
    let mut total_events = 0;

    for (i, coordinator) in coordinators.iter().enumerate() {
        let status = coordinator.get_coordinator_status().await?;
        total_peers += status.discovered_peer_count;
        total_events += status.total_events_forwarded;

        info!("   📊 Node {} stats:", i + 1);
        info!("      • Peers discovered: {}", status.discovered_peer_count);
        info!("      • Events forwarded: {}", status.total_events_forwarded);
        info!("      • Consensus messages: {}", status.consensus_messages_processed);
    }

    // Test coordinated discovery across all nodes
    info!("   🔄 Testing coordinated discovery across all nodes...");
    let coordinated_start = Instant::now();

    let mut all_announced_peers = Vec::new();
    for (i, coordinator) in coordinators.iter().enumerate() {
        let announced = coordinator.force_discovery_and_announce().await?;
        all_announced_peers.extend(announced);
        info!("   📢 Node {} announced {} peers", i + 1, announced.len());
    }

    let coordinated_time = coordinated_start.elapsed();
    info!("   ✅ Coordinated discovery completed in {:.2}s", coordinated_time.as_secs_f64());
    info!("   📈 Total unique announcements: {}", all_announced_peers.len());

    // Validate network convergence
    assert!(coordinated_time < Duration::from_secs(60), "Coordinated discovery too slow");

    // Clean shutdown of all coordinators
    info!("   🛑 Shutting down all coordinators...");
    for (i, coordinator) in coordinators.iter_mut().enumerate() {
        coordinator.stop().await?;
        info!("   ✅ Node {} stopped", i + 1);
    }

    info!("   ✅ Multi-node gossip network test completed successfully");
    info!("   🎯 Network convergence and gossip propagation validated");

    Ok(())
}

/// Performance metrics and validation helper
struct PerformanceMetrics {
    bridge_init_time: Duration,
    startup_time: Duration,
    discovery_latency: Duration,
    gossip_propagation_time: Duration,
}

impl PerformanceMetrics {
    fn validate_targets(&self) -> Result<()> {
        let mut issues = Vec::new();

        if self.bridge_init_time > Duration::from_secs(5) {
            issues.push(format!("Bridge init too slow: {:.2}s", self.bridge_init_time.as_secs_f64()));
        }

        if self.startup_time > Duration::from_secs(10) {
            issues.push(format!("Startup too slow: {:.2}s", self.startup_time.as_secs_f64()));
        }

        if self.discovery_latency > Duration::from_secs(30) {
            issues.push(format!("Discovery too slow: {:.2}s", self.discovery_latency.as_secs_f64()));
        }

        if self.gossip_propagation_time > Duration::from_secs(1) {
            issues.push(format!("Gossip too slow: {:.2}s", self.gossip_propagation_time.as_secs_f64()));
        }

        if !issues.is_empty() {
            return Err(anyhow::anyhow!("Performance targets not met: {}", issues.join(", ")));
        }

        Ok(())
    }

    fn report(&self) {
        info!("📊 PERFORMANCE REPORT");
        info!("   • Bridge initialization: {:.2}s (target: <5s)", self.bridge_init_time.as_secs_f64());
        info!("   • Coordinator startup: {:.2}s (target: <10s)", self.startup_time.as_secs_f64());
        info!("   • Discovery latency: {:.2}s (target: <30s)", self.discovery_latency.as_secs_f64());
        info!("   • Gossip propagation: {:.2}s (target: <1s)", self.gossip_propagation_time.as_secs_f64());
    }
}