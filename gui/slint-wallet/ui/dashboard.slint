import { Theme, Card, NavButton } from "theme.slint";

export struct TokenInfo {
    name: string,
    symbol: string,
    balance: string,
    value-usd: string,
}

export component DashboardScreen inherits Rectangle {
    in property <string> address: "";
    in property <string> qug-balance: "0.00";
    in property <string> qug-value-usd: "$0.00";
    in property <[TokenInfo]> tokens: [];
    in-out property <bool> copy-feedback: false;

    callback navigate(int);
    callback copy-address();
    callback send-token(string); // symbol of token to send

    background: Theme.bg-primary;

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;

        // Header
        HorizontalLayout {
            alignment: space-between;
            height: 32px;

            Text {
                text: "Dashboard";
                color: Theme.text-primary;
                font-size: Theme.font-xl;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        // Wallet Address Card
        Card {
            height: 56px;

            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Wallet Address";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                    }
                    Text {
                        text: root.address;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                        max-width: 280px;
                    }
                }

                Rectangle {
                    width: 72px;
                    border-radius: Theme.radius-sm;
                    background: copy-touch.has-hover ? Theme.bg-hover : transparent;

                    copy-touch := TouchArea {
                        clicked => { root.copy-address(); }
                    }

                    Text {
                        text: root.copy-feedback ? "Copied!" : "Copy";
                        color: root.copy-feedback ? Theme.accent-green : Theme.accent-blue;
                        font-size: Theme.font-sm;
                        font-weight: root.copy-feedback ? 700 : 400;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // QUG Balance Card
        Card {
            height: 130px;

            VerticalLayout {
                padding: Theme.spacing-lg;
                alignment: center;
                spacing: Theme.spacing-xs;

                Text {
                    text: "QUG Balance";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.qug-balance;
                    color: Theme.text-primary;
                    font-size: Theme.font-3xl;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.qug-value-usd;
                    color: Theme.accent-green;
                    font-size: Theme.font-lg;
                    horizontal-alignment: center;
                }
            }
        }

        // Custom Tokens
        HorizontalLayout {
            alignment: space-between;
            height: 24px;

            Text {
                text: "My Tokens";
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                font-weight: 600;
                vertical-alignment: center;
            }

            if root.tokens.length > 0 : Text {
                text: root.tokens.length + " token" + (root.tokens.length > 1 ? "s" : "");
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }

        // Token list (scrollable)
        Flickable {
            viewport-height: root.tokens.length * 72px;

            VerticalLayout {
                spacing: Theme.spacing-sm;

                for token[i] in root.tokens : Card {
                    height: 64px;

                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-sm;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: token.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-md;
                                font-weight: 500;
                            }
                            Text {
                                text: token.symbol;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Text {
                                    text: token.balance;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-md;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: token.value-usd;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-xs;
                                    horizontal-alignment: right;
                                }
                            }

                            // Send button for each token
                            Rectangle {
                                width: 52px;
                                height: 32px;
                                border-radius: Theme.radius-sm;
                                background: send-touch.has-hover ? Theme.accent-green.darker(15%) : Theme.accent-green;
                                animate background { duration: 150ms; }

                                VerticalLayout {
                                    alignment: center;
                                }

                                send-touch := TouchArea {
                                    clicked => { root.send-token(token.symbol); }
                                }

                                Text {
                                    text: "Send";
                                    color: Theme.text-primary;
                                    font-size: Theme.font-xs;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Quick Actions
        HorizontalLayout {
            spacing: Theme.spacing-sm;

            NavButton {
                label: "Receive";
                clicked => { root.navigate(5); }
            }
            NavButton {
                label: "Send";
                clicked => { root.navigate(2); }
            }
            NavButton {
                label: "History";
                clicked => { root.navigate(3); }
            }
            NavButton {
                label: "Miner";
                clicked => { root.navigate(4); }
            }
        }
    }
}
