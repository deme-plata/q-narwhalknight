import { Theme, QButton, QInput, Card, GradientCard, Icon } from "theme.slint";

// Action card: frosted-glass clickable tile with icon, title, description,
// a glowing accent stripe, and a frosted top-edge highlight (Cyan Flux glass).
component ActionCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <image> icon-source;
    in property <color> accent;
    in property <bool> selected: false;
    in property <bool> featured: false;   // recommended card → extra cyan glow at rest
    callback clicked;

    height: 132px;
    border-radius: Theme.radius-lg;
    // Translucent cool glass fill; brightens on hover / when selected.
    background: selected
        ? root.accent.with-alpha(0.16)
        : (touch.has-hover ? #16243f.with-alpha(0.80)
           : (root.featured ? #13283f.with-alpha(0.68) : Theme.bg-secondary.with-alpha(0.56)));
    border-width: 1px;
    border-color: (selected || touch.has-hover)
        ? root.accent.with-alpha(0.70)
        : root.accent.with-alpha(root.featured ? 0.42 : 0.22);
    drop-shadow-blur: (selected || touch.has-hover) ? 24px : (root.featured ? 18px : 9px);
    drop-shadow-offset-y: 4px;
    drop-shadow-color: (selected || touch.has-hover)
        ? root.accent.with-alpha(0.32)
        : root.accent.with-alpha(root.featured ? 0.20 : 0.10);
    animate background, border-color, drop-shadow-blur, drop-shadow-color { duration: 160ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Frosted top-edge highlight (the "glass" sheen)
    Rectangle {
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: 1px;
        background: @linear-gradient(90deg,
            transparent 0%,
            #ffffff.with-alpha(0.22) 50%,
            transparent 100%);
    }

    // Glowing accent stripe on the left
    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        background: @linear-gradient(180deg, root.accent, root.accent.with-alpha(0.45));
        border-top-left-radius: Theme.radius-lg;
        border-bottom-left-radius: Theme.radius-lg;
        drop-shadow-blur: 8px;
        drop-shadow-color: root.accent.with-alpha(0.55);
    }

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-md;
        padding-top: Theme.spacing-md;
        padding-bottom: Theme.spacing-md;
        spacing: Theme.spacing-md;

        // Icon tile (glass + accent ring + glow)
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: Theme.radius-md;
            background: root.accent.with-alpha(0.14);
            border-width: 1px;
            border-color: root.accent.with-alpha(0.45);
            y: (parent.height - 56px) / 2;
            drop-shadow-blur: 10px;
            drop-shadow-color: root.accent.with-alpha(0.30);

            Icon {
                source: root.icon-source;
                icon-color: root.accent;
                width: 28px;
                height: 28px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                font-weight: 700;
            }
            Text {
                text: root.description;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                wrap: word-wrap;
            }
        }

        // Chevron
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/arrow-right.svg");
                icon-color: root.accent.with-alpha(0.8);
                width: Theme.icon-md;
                height: Theme.icon-md;
            }
        }
    }
}

export component LoginScreen inherits Rectangle {
    in-out property <string> mnemonic-text: "";
    in-out property <string> server-url: "https://quillon.xyz";
    in-out property <string> generated-mnemonic: "";
    in-out property <string> create-password: "";
    in property <bool> has-locked-wallet: false;
    in-out property <string> unlock-password: "";
    callback unlock-wallet(string);
    in-out property <string> error-message: "";
    in-out property <bool> show-create-view: false;
    in property <bool> oauth-server-running: true;
    in property <int> oauth-port: 17655;
    in property <string> wallet-version: "v10.9.23";

    // Internal: which expanded panel is showing (0=none, 1=import, 2=oauth)
    in-out property <int> active-action: 0;

    callback create-wallet();
    callback import-wallet(string);
    callback confirm-created();
    callback open-oauth-browser();

    background: Theme.bg-primary;

    // Depth gradient: a touch of teal-navy at the top fading to near-black.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, Theme.bg-primary 0%, Theme.bg-primary 55%, Theme.bg-primary 100%);
    }

    // Cyan glow behind the logo (top-center)
    Rectangle {
        x: (parent.width - 540px) / 2;
        y: -200px;
        width: 540px;
        height: 440px;
        border-radius: 270px;
        background: @radial-gradient(circle,
            Theme.accent-cyan.with-alpha(0.16) 0%,
            Theme.accent-cyan.with-alpha(0.05) 55%,
            transparent 100%);
    }

    // Cyan corner glow (top-left)
    Rectangle {
        x: -160px;
        y: -120px;
        width: 380px;
        height: 380px;
        border-radius: 190px;
        background: @radial-gradient(circle,
            Theme.accent-cyan.with-alpha(0.13) 0%,
            transparent 70%);
    }

    // Teal/violet corner glow (bottom-right)
    Rectangle {
        x: parent.width - 240px;
        y: parent.height - 300px;
        width: 440px;
        height: 440px;
        border-radius: 220px;
        background: @radial-gradient(circle,
            #8b5cf6.with-alpha(0.10) 0%,
            Theme.accent-cyan.with-alpha(0.04) 55%,
            transparent 100%);
    }

    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.spacing-xl;
            padding-right: Theme.spacing-xl;
            padding-top: Theme.spacing-xl;
            padding-bottom: Theme.spacing-lg;
            spacing: Theme.spacing-lg;

            // ─────────────────────────────────────────────
            // HERO: Quillon Graph logo + brand
            // ─────────────────────────────────────────────
            VerticalLayout {
                alignment: center;
                spacing: Theme.spacing-md;
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-sm;

                HorizontalLayout {
                    alignment: center;

                    // Logo halo (bright cyan glow + thin ring)
                    Rectangle {
                        width: 132px;
                        height: 132px;
                        border-radius: 66px;
                        background: @radial-gradient(circle,
                            Theme.accent-cyan.with-alpha(0.22) 0%,
                            Theme.accent-cyan.with-alpha(0.10) 55%,
                            transparent 100%);
                        border-width: 1px;
                        border-color: Theme.accent-cyan.with-alpha(0.28);
                        drop-shadow-blur: 38px;
                        drop-shadow-color: Theme.accent-cyan.with-alpha(0.35);

                        // Quillon Graph logo (white-on-transparent shield, tinted bright cyan)
                        Image {
                            source: @image-url("icons/quillon-logo.png");
                            colorize: Theme.accent-cyan;
                            width: 94px;
                            height: 94px;
                            x: (parent.width - 94px) / 2;
                            y: (parent.height - 94px) / 2;
                            image-fit: contain;
                        }
                    }
                }

                Text {
                    text: "Quillon Graph";
                    color: Theme.text-primary;
                    font-size: Theme.font-3xl;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Quantum-Secure · Post-Quantum Signatures · Self-Custodial";
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    letter-spacing: 0.4px;
                    horizontal-alignment: center;
                }
            }

            // ─────────────────────────────────────────────
            // UNLOCK: password prompt when an encrypted wallet exists but no session
            // ─────────────────────────────────────────────
            if root.has-locked-wallet : Card {
                VerticalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-md;
                    Text {
                        text: "Welcome back — unlock your wallet";
                        color: Theme.text-primary;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    QInput {
                        placeholder: "Enter your wallet password";
                        is-password: true;
                        text <=> root.unlock-password;
                    }
                    QButton {
                        label: "Unlock";
                        button-color: Theme.accent-cyan;
                        clicked => { root.unlock-wallet(root.unlock-password); }
                    }
                }
            }

            // ─────────────────────────────────────────────
            // CREATE-VIEW: mnemonic display
            // ─────────────────────────────────────────────
            if root.show-create-view : Card {
                VerticalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-md;

                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Icon {
                            source: @image-url("icons/shield-check.svg");
                            icon-color: Theme.accent-yellow;
                            width: Theme.icon-lg;
                            height: Theme.icon-lg;
                        }
                        Text {
                            text: "Your Recovery Phrase";
                            color: Theme.accent-yellow;
                            font-size: Theme.font-lg;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Write these words down on paper and store them somewhere safe. Anyone with this phrase can take your funds. We cannot recover them for you.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 130px;
                        border-radius: Theme.radius-md;
                        background: Theme.bg-input;
                        border-width: 1px;
                        border-color: Theme.accent-yellow.with-alpha(0.3);

                        Text {
                            x: 14px;
                            y: 12px;
                            width: parent.width - 28px;
                            text: root.generated-mnemonic;
                            color: Theme.accent-cyan;
                            font-size: Theme.font-md;
                            font-weight: 500;
                            wrap: word-wrap;
                        }
                    }

                    QInput {
                        placeholder: "Set a wallet password (min 8 chars)";
                        is-password: true;
                        text <=> root.create-password;
                    }
                    QButton {
                        label: "I have saved my recovery phrase";
                        button-color: Theme.accent-green;
                        clicked => { root.confirm-created(); }
                    }
                }
            }

            // ─────────────────────────────────────────────
            // ACTION CARDS (initial view)
            // ─────────────────────────────────────────────
            if !root.show-create-view : VerticalLayout {
                spacing: Theme.spacing-md;

                // Action 1: Open with Browser (OAuth2) — primary path
                ActionCard {
                    title: "Sign in with Browser";
                    description: root.oauth-server-running
                        ? "OAuth2 — opens your browser to authorize this wallet (recommended)"
                        : "OAuth2 server unavailable on port " + root.oauth-port;
                    icon-source: @image-url("icons/scan-line.svg");
                    accent: Theme.accent-cyan;
                    featured: true;
                    selected: root.active-action == 2;
                    clicked => {
                        root.active-action = root.active-action == 2 ? 0 : 2;
                    }
                }

                if root.active-action == 2 : Card {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.oauth-server-running ? Theme.accent-green : Theme.accent-red;
                                    drop-shadow-blur: root.oauth-server-running ? 6px : 0px;
                                    drop-shadow-color: Theme.accent-green.with-alpha(0.5);
                                }
                            }
                            Text {
                                text: root.oauth-server-running ? "Authorization server running" : "Server stopped";
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                            }
                        }

                        QButton {
                            label: "Open browser to authorize";
                            button-color: Theme.accent-cyan;
                            clicked => { root.open-oauth-browser(); }
                        }

                        Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.accent-cyan.with-alpha(0.2);

                            Text {
                                x: 10px;
                                text: "localhost:" + root.oauth-port + "/authorize";
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Action 2: Create new wallet
                ActionCard {
                    title: "Create a new wallet";
                    description: "Generate a fresh 12-word recovery phrase and start fresh";
                    icon-source: @image-url("icons/sparkles.svg");
                    accent: Theme.accent-cyan;
                    clicked => { root.create-wallet(); }
                }

                // Action 3: Import existing
                ActionCard {
                    title: "Import existing wallet";
                    description: "Restore from a 12 or 24 word recovery phrase";
                    icon-source: @image-url("icons/wallet.svg");
                    accent: #8b5cf6;
                    selected: root.active-action == 1;
                    clicked => {
                        root.active-action = root.active-action == 1 ? 0 : 1;
                    }
                }

                if root.active-action == 1 : Card {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        Text {
                            text: "Recovery phrase";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                        }
                        QInput {
                            text <=> root.mnemonic-text;
                            placeholder: "word1 word2 word3 ...";
                            accepted(text) => { root.import-wallet(root.mnemonic-text); }
                        }
                        QButton {
                            label: "Import wallet";
                            button-color: Theme.accent-purple;
                            clicked => { root.import-wallet(root.mnemonic-text); }
                        }
                    }
                }
            }

            // ─────────────────────────────────────────────
            // SERVER URL (compact, advanced)
            // ─────────────────────────────────────────────
            Rectangle {
                height: 64px;
                border-radius: Theme.radius-md;
                background: Theme.bg-secondary.with-alpha(0.55);
                border-width: 1px;
                border-color: Theme.accent-cyan.with-alpha(0.18);

                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-md;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: @image-url("icons/circle-dot.svg");
                            icon-color: Theme.accent-cyan;
                            width: Theme.icon-md;
                            height: Theme.icon-md;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Node endpoint";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                        }
                        QInput {
                            text <=> root.server-url;
                            placeholder: "https://quillon.xyz";
                        }
                    }
                }
            }

            // ─────────────────────────────────────────────
            // ERROR / FOOTER
            // ─────────────────────────────────────────────
            if root.error-message != "" : Rectangle {
                height: self.preferred-height;
                border-radius: Theme.radius-md;
                background: Theme.accent-red.with-alpha(0.12);
                border-width: 1px;
                border-color: Theme.accent-red.with-alpha(0.4);

                HorizontalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-sm;

                    Icon {
                        source: @image-url("icons/x.svg");
                        icon-color: Theme.accent-red;
                        width: Theme.icon-md;
                        height: Theme.icon-md;
                    }
                    Text {
                        text: root.error-message;
                        color: Theme.accent-red;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Footer (build / branding)
            HorizontalLayout {
                alignment: center;
                spacing: Theme.spacing-sm;
                padding-top: Theme.spacing-md;

                Text {
                    text: root.wallet-version;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
                Text {
                    text: "·";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
                Text {
                    text: "Q-NarwhalKnight · Post-Quantum Consensus";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
            }
        }
    }
}
