import { Theme, QButton, QInput, Card } from "theme.slint";

export component LoginScreen inherits Rectangle {
    in-out property <string> mnemonic-text: "";
    in-out property <string> server-url: "https://quillon.xyz";
    in-out property <string> generated-mnemonic: "";
    in-out property <string> error-message: "";
    in-out property <bool> show-create-view: false;
    in property <bool> oauth-server-running: true;
    in property <int> oauth-port: 17655;

    callback create-wallet();
    callback import-wallet(string);
    callback confirm-created();
    callback open-oauth-browser();

    background: Theme.bg-primary;

    Flickable {
        VerticalLayout {
            alignment: center;
            padding: Theme.spacing-xl;
            spacing: Theme.spacing-lg;

            // Logo / Title
            Text {
                text: "Q-NarwhalKnight";
                color: Theme.accent-cyan;
                font-size: Theme.font-3xl;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Native Wallet";
                color: Theme.text-secondary;
                font-size: Theme.font-lg;
                horizontal-alignment: center;
            }

            // Server URL
            Card {
                height: 80px;
                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-xs;

                    Text {
                        text: "Server URL";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                    }
                    QInput {
                        text <=> root.server-url;
                        placeholder: "https://quillon.xyz";
                    }
                }
            }

            if !root.show-create-view : VerticalLayout {
                spacing: Theme.spacing-md;

                // Import Section
                Card {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        Text {
                            text: "Import Wallet";
                            color: Theme.text-primary;
                            font-size: Theme.font-lg;
                            font-weight: 600;
                        }
                        Text {
                            text: "Enter your 12 or 24 word recovery phrase";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                        }

                        QInput {
                            text <=> root.mnemonic-text;
                            placeholder: "word1 word2 word3 ...";
                            accepted(text) => { root.import-wallet(root.mnemonic-text); }
                        }

                        QButton {
                            label: "Import Wallet";
                            clicked => { root.import-wallet(root.mnemonic-text); }
                        }
                    }
                }

                // Divider
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "- or -";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                    }
                }

                // Create New
                QButton {
                    label: "Create New Wallet";
                    button-color: Theme.accent-green;
                    clicked => { root.create-wallet(); }
                }

                // Divider
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "- or -";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                    }
                }

                // OAuth2 Connect via Browser
                Card {
                    height: self.preferred-height;
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            alignment: start;

                            // Status dot
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: root.oauth-server-running ? Theme.accent-green : Theme.accent-red;
                                }
                            }

                            Text {
                                text: "OAuth2 Connect";
                                color: Theme.text-primary;
                                font-size: Theme.font-md;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: "Authorize this wallet to access your node via OAuth2. Opens your browser for secure consent.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            wrap: word-wrap;
                        }

                        QButton {
                            label: "Open Browser to Authorize";
                            button-color: Theme.accent-blue;
                            clicked => { root.open-oauth-browser(); }
                        }

                        // OAuth URL display
                        Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.accent-cyan.with-alpha(0.2);

                            Text {
                                x: 10px;
                                text: "localhost:" + root.oauth-port + "/authorize";
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

        // Show generated mnemonic
        if root.show-create-view : Card {
            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                Text {
                    text: "Your Recovery Phrase";
                    color: Theme.accent-yellow;
                    font-size: Theme.font-lg;
                    font-weight: 600;
                }
                Text {
                    text: "Write down these words and keep them safe. You will need them to recover your wallet.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 100px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: Theme.accent-yellow.with-alpha(0.3);

                    Text {
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        text: root.generated-mnemonic;
                        color: Theme.accent-cyan;
                        font-size: Theme.font-md;
                        wrap: word-wrap;
                    }
                }

                QButton {
                    label: "I Have Saved My Phrase";
                    button-color: Theme.accent-green;
                    clicked => { root.confirm-created(); }
                }
            }
        }

        // Error message
        if root.error-message != "" : Text {
            text: root.error-message;
            color: Theme.accent-red;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        }
    }
}
