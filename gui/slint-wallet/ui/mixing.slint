// Quantum Mixer animation (Slint-native, runs inside the wallet's software renderer).
// Metaphor: your transaction (glowing core) shuffled among orbiting decoy nodes,
// wrapped by counter-rotating ring-signature rings, with sonar energy pulses and a
// sparkle starfield. Cyan Flux-glass palette. All motion is trig/scale-driven so it
// paints with the software renderer (no rotation-angle / no GPU).
export component MixingAnimation inherits Rectangle {
    in property <string> amount: "100.00 QUG";
    in property <string> recipient: "qnk1f97…6d67";
    in property <string> privacy-level: "HIGH";
    in property <int> decoys: 15;

    // continuous animation drivers
    property <angle> orbit: 0deg;
    property <angle> ring1: 0deg;
    property <angle> ring2: 0deg;
    property <float> glow: 0.0;
    property <float> sonar-a: 0.0;
    property <float> sonar-b: 0.0;
    property <float> twinkle: 0.0;

    init => {
        self.orbit = 360deg;
        self.ring1 = 360deg;
        self.ring2 = 360deg;
        self.glow = 1.0;
        self.sonar-a = 1.0;
        self.sonar-b = 1.0;
        self.twinkle = 1.0;
    }
    animate orbit  { duration: 9s;  iteration-count: -1; easing: linear; }
    animate ring1  { duration: 14s; iteration-count: -1; easing: linear; }
    animate ring2  { duration: 11s; iteration-count: -1; easing: linear; }
    animate glow   { duration: 1400ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    animate sonar-a { duration: 2600ms; iteration-count: -1; easing: ease-out; }
    animate sonar-b { duration: 2600ms; iteration-count: -1; easing: ease-out; delay: 1300ms; }
    animate twinkle { duration: 1800ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }

    // geometry
    property <length> cx: root.width / 2;
    property <length> cy: root.height / 2 - 30px;
    property <length> orbit-r: 150px;

    background: #070b16;

    // depth + ambient glows
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: @linear-gradient(180deg, #0a1322 0%, #080e1a 60%, #060912 100%);
    }
    Rectangle {
        x: root.cx - 300px; y: root.cy - 300px; width: 600px; height: 600px; border-radius: 300px;
        background: @radial-gradient(circle, #22d3ee.with-alpha(0.16) 0%, #22d3ee.with-alpha(0.04) 55%, transparent 100%);
    }
    Rectangle {
        x: root.width - 240px; y: root.height - 260px; width: 420px; height: 420px; border-radius: 210px;
        background: @radial-gradient(circle, #8b5cf6.with-alpha(0.12) 0%, transparent 70%);
    }

    // ── sparkle starfield (scattered, twinkling) ──
    for i in 22 : Rectangle {
        property <length> rr: 188px + mod(i * 17, 90) * 1px;
        property <angle> aa: i * 47deg;
        width: 2px + mod(i, 3) * 1px; height: self.width; border-radius: self.width / 2;
        x: root.cx + rr * cos(aa) - self.width / 2;
        y: root.cy + rr * sin(aa) - self.width / 2;
        background: #7dd3fc.with-alpha(0.25 + (mod(i, 2) == 0 ? root.twinkle : 1.0 - root.twinkle) * 0.45);
    }

    // ── sonar energy pulses expanding from the core ──
    Rectangle {
        property <length> rr: 56px + root.sonar-a * 150px;
        x: root.cx - rr; y: root.cy - rr; width: rr * 2; height: rr * 2; border-radius: rr;
        background: transparent; border-width: 1.5px;
        border-color: #22d3ee.with-alpha((1.0 - root.sonar-a) * 0.45);
    }
    Rectangle {
        property <length> rr: 56px + root.sonar-b * 150px;
        x: root.cx - rr; y: root.cy - rr; width: rr * 2; height: rr * 2; border-radius: rr;
        background: transparent; border-width: 1.5px;
        border-color: #2dd4bf.with-alpha((1.0 - root.sonar-b) * 0.40);
    }

    // ── outer ring-signature ring (outline + spinning segment dots) ──
    Rectangle {
        x: root.cx - 168px; y: root.cy - 168px; width: 336px; height: 336px;
        border-radius: 168px; border-width: 1px; border-color: #22d3ee.with-alpha(0.28);
        background: transparent;
    }
    for i in 12 : Rectangle {
        property <angle> a: root.ring1 + i * 30deg;
        width: 6px; height: 6px; border-radius: 3px;
        background: #22d3ee;
        drop-shadow-blur: 5px; drop-shadow-color: #22d3ee.with-alpha(0.7);
        x: root.cx + 166px * cos(a) - 3px;
        y: root.cy + 166px * sin(a) - 3px;
    }

    // ── inner ring (counter-spin) ──
    Rectangle {
        x: root.cx - 120px; y: root.cy - 120px; width: 240px; height: 240px;
        border-radius: 120px; border-width: 1px; border-color: #2dd4bf.with-alpha(0.30);
        background: transparent;
    }
    for i in 8 : Rectangle {
        property <angle> a: 22deg - root.ring2 + i * 45deg;
        width: 5px; height: 5px; border-radius: 3px;
        background: #2dd4bf;
        drop-shadow-blur: 5px; drop-shadow-color: #2dd4bf.with-alpha(0.7);
        x: root.cx + 118px * cos(a) - 2.5px;
        y: root.cy + 118px * sin(a) - 2.5px;
    }

    // ── orbiting decoy nodes (solid circles; one is the real tx) ──
    for i in 15 : Rectangle {
        property <angle> a: root.orbit + i * 24deg;
        property <bool> real: i == 4;
        width: real ? 18px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        x: root.cx + root.orbit-r * cos(a) - self.width / 2;
        y: root.cy + root.orbit-r * sin(a) - self.width / 2;
        background: real ? #eafdff : #38e0f5;
        border-width: real ? 2px : 0px;
        border-color: #ffffff.with-alpha(0.8);
        drop-shadow-blur: real ? 16px : 8px;
        drop-shadow-color: real ? #ffffff.with-alpha(0.9) : #22d3ee.with-alpha(0.65);
    }

    // ── glowing core (your transaction) ──
    Rectangle {
        x: root.cx - 66px; y: root.cy - 66px; width: 132px; height: 132px; border-radius: 66px;
        background: @radial-gradient(circle, #22d3ee.with-alpha(0.22) 0%, #8b5cf6.with-alpha(0.10) 60%, transparent 100%);
        drop-shadow-blur: 30px + root.glow * 20px;
        drop-shadow-color: #22d3ee.with-alpha(0.5);

        Rectangle {
            x: parent.width / 2 - 47px; y: parent.height / 2 - 47px; width: 94px; height: 94px; border-radius: 47px;
            background: @radial-gradient(circle, #123249 0%, #0a1626 100%);
            border-width: 1.5px; border-color: #22d3ee.with-alpha(0.6 + root.glow * 0.3);
            VerticalLayout {
                alignment: center; spacing: 1px;
                Text { text: "⬡"; color: #5eeaff; font-size: 28px; horizontal-alignment: center; }
                Text { text: "mixing"; color: #9fe7ff; font-size: 10px; horizontal-alignment: center; }
            }
        }
    }

    // ── caption block ──
    VerticalLayout {
        x: 0; y: root.height - 188px; width: 100%;
        alignment: start; spacing: 6px; padding-left: 40px; padding-right: 40px;

        HorizontalLayout {
            alignment: center; spacing: 8px;
            Text { text: "Quantum Mixing"; color: #f1f5f9; font-size: 24px; font-weight: 800; }
            Rectangle {
                width: 54px; height: 22px; border-radius: 11px; y: 4px;
                background: #22d3ee.with-alpha(0.14); border-width: 1px; border-color: #22d3ee.with-alpha(0.5);
                Text { text: root.privacy-level; color: #22d3ee; font-size: 11px; font-weight: 700;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text {
            text: "Shuffling " + root.amount + " through " + root.decoys + " decoys · ring signature + stealth address";
            color: #94a3b8; font-size: 13px; horizontal-alignment: center; wrap: word-wrap;
        }
        Text {
            text: "→ " + root.recipient;
            color: #64748b; font-size: 12px; horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center; spacing: 8px; padding-top: 8px;
            for i in 5 : Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: i <= 2 ? #22d3ee : #22d3ee.with-alpha(0.25);
            }
        }
    }
}
