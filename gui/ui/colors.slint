// Q-NarwhalKnight Color Palette
export global Colors {
    // Primary quantum colors
    out property <color> quantum-primary: #00d4ff;
    out property <color> quantum-blue: #00d4ff;
    out property <color> quantum-purple: #8b5cf6;
    out property <color> quantum-green: #00ff88;
    out property <color> quantum-gold: #fbbf24;
    out property <color> quantum-red: #ff3366;
    
    // Background and surface colors
    out property <color> background-primary: #0a0e17;
    out property <color> background-secondary: #0f1419;
    out property <color> card-background: #1e293b66;
    out property <color> card-bg: #1e293b66;
    out property <color> glass-surface: #1e293b99;
    
    // Text colors
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #64748b;
    
    // UI element colors
    out property <color> border-color: #334155;
    out property <color> hover-overlay: #ffffff11;
    out property <color> active-overlay: #ffffff22;
    
    // Status colors
    out property <color> success: #10b981;
    out property <color> warning: #f59e0b;
    out property <color> error: #ef4444;
    out property <color> info: #3b82f6;
    
    // Transparency
    out property <color> transparent: transparent;
    out property <color> overlay-medium: #00000066;
}
