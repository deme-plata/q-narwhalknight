[target.x86_64-unknown-linux-gnu]
rustflags = [
    "-C", "link-arg=-lpng",
    "-C", "link-arg=-lz",
    "-C", "link-arg=-lbrotlidec",
    "-C", "link-arg=-lbrotlicommon",
    "-C", "link-arg=-lexpat",
    "-C", "link-arg=-L/usr/lib/x86_64-linux-gnu",
    "-C", "link-arg=/usr/lib/x86_64-linux-gnu/libxml2.so.2"
]
